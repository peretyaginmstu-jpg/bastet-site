# Configuration for the Bastet request form service (submit.py).
# 1) cp submit.env.example submit.env
# 2) Fill in BASTET_SMTP_PASSWORD with the Yandex app password
#    (Yandex 360 - Security - App passwords - Mail/SMTP).
# 3) Put submit.env on the server at /opt/bastet/ and chmod 600 submit.env.
# submit.env is in .gitignore, so secrets never reach git.

# Listen on loopback only; nginx proxies public requests here.
BASTET_BIND_HOST=127.0.0.1
BASTET_BIND_PORT=8751

# Yandex 360 mail for the domain: SMTP.
BASTET_SMTP_HOST=smtp.yandex.ru
BASTET_SMTP_PORT=465
BASTET_SMTP_USER=info@bastet-dez.ru
BASTET_SMTP_PASSWORD=REPLACE_WITH_YANDEX_APP_PASSWORD

# Where requests are delivered. Usually the same mailbox as BASTET_SMTP_USER.
BASTET_TO=info@bastet-dez.ru

# Optional request log. Empty means logging is off (requests are not stored).
# BASTET_LOG_FILE=/opt/bastet/requests.log

# Spam protection: at most 3 requests per 10 minutes from one IP.
BASTET_RATE_MAX=3
BASTET_RATE_WINDOW=600

# Maximum request body size in bytes (matches client_max_body_size in nginx).
BASTET_MAX_BODY=32768